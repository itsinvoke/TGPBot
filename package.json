{
  "name": "tdcbot",
  "version": "1.0.0",
  "description": "Multi-bot system for alt.6b6t.org - Guard Bot + Discord Bot",
  "main": "guard_bot.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node guard_bot.js",
    "guard": "node guard_bot.js",
    "discord": "node discord_bot.js",
    "both": "concurrently \"npm run guard\" \"npm run discord\"",
    "install-deps": "npm install"
  },
  "keywords": [
    "minecraft",
    "bot",
    "mineflayer",
    "discord",
    "6b6t"
  ],
  "author": "TDC",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItsInvoke/TGPBot"
  },
  "dependencies": {
    "axios": "1.6.0",
    "cheerio": "1.0.0-rc.12",
    "discord.js": "14.0.0",
    "dotenv": "16.0.0",
    "mineflayer": "4.12.0",
    "mineflayer-pathfinder": "2.4.5",
    "vec3": "0.1.7"
  },
  "devDependencies": {
    "concurrently": "8.0.0"
  }
}
